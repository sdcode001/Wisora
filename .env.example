# Wisora environment — copy to .env and fill in real values. Never commit .env.
META_API_KEY=
TAVILY_API_KEY=
# Google sign-in (https://console.cloud.google.com/apis/credentials):
# create an "OAuth client ID" of type "Web application" and register
# http://localhost:3000 as an authorized JavaScript origin.
GOOGLE_OAUTH_CLIENT_ID=
# Random secret for signing session cookies. Generate with:
# openssl rand -base64 32
SESSION_SECRET=
# MongoDB (REQUIRED on serverless hosts like Netlify, where the disk is
# read-only; without it, Wisora stores data in local JSON files instead).
# Get a free cluster at https://cloud.mongodb.com — database name defaults
# to "wisora".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Price alerts via Resend (https://resend.com): without a key, price alerts
# are in-app only. Free tier sends to your own verified address until you
# verify a domain.
RESEND_API_KEY=
RESEND_FROM=Wisora <alerts@yourdomain.com>
# Background price monitor: interval in minutes (default 240 = 4h, min 5),
# max watches re-checked per cycle, or off to disable.
WISORA_CHECK_INTERVAL_MINUTES=240

